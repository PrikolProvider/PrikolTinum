{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/pacan/.config/fastfetch/poopyman.png",
        "position": "left",
        "width": 25,
        "padding": {
            "top": 1,
            "left": 2,
            "bottom": 1
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌───────────────┐"
        },
        {
            "type": "users",
            "myselfOnly": true,
            "key": "│ {#yellow}{#keys} user        │",
            "format": "{#red}{name}"
        },
        {
            "type": "host",
            "key": "│ {#green}{#keys} hname       │",
            "format": "{#yellow}{name}"
        },
        {
            "type": "os",
            "key": "│ {#cyan}{#keys} distro      │",
            "format": "{#green}BebraOs"
        },
        {
            "type": "kernel",
            "key": "│ {#blue}{#keys} kernel      │",
            "format": "{#cyan}Bebrakernel"
        },
        {
            "type": "uptime",
            "key": "│ {#magenta}{#keys} uptime      │",
            "format": "{#blue}{?days}{days}d {?}{hours}h {minutes}m"
        },
        {
            "type": "shell",
            "key": "│ {#red}{#keys} shell       │",
            "format": "{#magenta}{exe-name}"
        },
        {
            "type": "packages",
            "key": "│ {#yellow}  {#keys}pkgs        │",
            "format": "{#red}{all}"
        },
        {
            "type": "memory",
            "key": "│ {#green}  {#keys}memory      │",
            "format": "{#yellow}{used} | {total}"
        },
        {
            "type": "custom",
            "format": "├───────────────┤"
        },
        {
            "type": "colors",
            "key": "│ {#blue}{#keys} colors      │",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "└───────────────┘"
        }
    ]
}
